/venv-orders/
/venv/*
__pycache__/
*.pyc
output/

# Scratch label images. These are rewritten on every print, so tracking
# them makes `git pull` fail on any PC that has printed even once.
current_label.png
current_big_box_label.png

# Per-machine printer names. Copy printers.example.json to printers.json
# and fill in the names from that PC's Windows printer list.
printers.json

# Local agent definitions and tool settings. Each machine keeps its own.
.claude/
.codex/

# Client shipment files (packing lists, label PDFs). Never committed.
envios/
claude_add_this_to_git_ignore*

# Lock files LibreOffice leaves next to an open spreadsheet.
.~lock.*#
